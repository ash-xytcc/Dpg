FROM node:22-bookworm-slim

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci \
  && npm install --no-save wrangler@4.131.2

COPY . .
RUN npm run build \
  && chmod +x /app/scripts/vps-entrypoint.sh \
  && mkdir -p /var/lib/dpg

ENV NODE_ENV=production
ENV DPG_STATE_DIR=/var/lib/dpg

EXPOSE 8788

ENTRYPOINT ["/app/scripts/vps-entrypoint.sh"]
